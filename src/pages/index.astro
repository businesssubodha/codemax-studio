---
import '../styles/global.css';

const projects = [
  { number: '01', title: 'Citizenship Exam', type: 'Product / Education', accent: 'orange', tag: 'Practice platform' },
  { number: '02', title: 'Power Plumbers', type: 'Directory / Local search', accent: 'blue', tag: 'Australia-wide' },
  { number: '03', title: 'Image by SD', type: 'Portfolio / Photography', accent: 'green', tag: 'Visual identity' }
];

const services = [
  ['01', 'Web design', 'Brand-led interfaces that make your business easier to choose.'],
  ['02', 'Web development', 'Fast, scalable websites built for real enquiries—not just screenshots.'],
  ['03', 'Growth systems', 'SEO, content and automation that keep your digital presence moving.']
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="CodeMax creates distinctive websites, digital products and growth systems for ambitious Australian businesses." />
    <title>CodeMax — Digital work with direction</title>
  </head>
  <body>
    <div class="cursor-orbit" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="CodeMax home"><span class="brand-mark">C<span>×</span></span><span>CODEMAX</span></a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
      </nav>
      <a class="header-cta" href="#contact">Start a project <span>↗</span></a>
    </header>

    <main id="top">
      <section class="hero section-grid">
        <div class="hero-meta mono"><span>(01)</span><span>Melbourne / Australia</span><span>Digital studio</span></div>
        <div class="hero-copy">
          <p class="eyebrow">Web design · Development · Growth</p>
          <h1>Make your<br /><em>future</em> visible.</h1>
          <p class="hero-intro">CodeMax is a digital studio for businesses ready to look as good online as they are in the real world.</p>
          <a class="circle-link" href="#work" aria-label="Explore selected work"><span>Explore<br />the work</span><b>↘</b></a>
        </div>
        <div class="hero-art" aria-label="Abstract CodeMax design system graphic">
          <div class="art-label mono">CM—2026 / SYSTEM 01</div>
          <div class="track track-a"></div><div class="track track-b"></div><div class="track track-c"></div>
          <div class="orbit-node node-a"></div><div class="orbit-node node-b"></div><div class="orbit-node node-c"></div>
          <div class="hero-symbol">C<span>×</span></div>
          <div class="art-caption">Ideas in<br /><strong>motion</strong></div>
        </div>
        <div class="scroll-note mono">Scroll to move <span>↓</span></div>
      </section>

      <section class="statement section-grid" id="about">
        <div class="section-index mono">(02)</div>
        <div class="statement-content">
          <p class="eyebrow">A small team with a wide field of view</p>
          <h2>Digital work should create <span>momentum.</span></h2>
          <p>We combine strategy, sharp design and dependable technology to build websites that earn attention and turn it into action. No templates. No vague promises. Just thoughtful digital work with a clear next step.</p>
        </div>
        <div class="statement-aside mono">Design is not decoration.<br />It is direction.</div>
      </section>

      <section class="work section-grid" id="work">
        <div class="section-heading"><span class="section-index mono">(03)</span><div><p class="eyebrow">Selected work</p><h2>Built for the <em>next</em> move.</h2></div></div>
        <div class="project-list">
          {projects.map((project) => (
            <article class={`project-card ${project.accent}`}>
              <div class="project-visual"><span class="project-number mono">{project.number}</span><div class="project-lines"></div><div class="project-badge">{project.tag}</div><span class="project-arrow">↗</span></div>
              <div class="project-info"><div><p class="mono">{project.type}</p><h3>{project.title}</h3></div><span class="view-case">View case <b>↗</b></span></div>
            </article>
          ))}
        </div>
      </section>

      <section class="services section-grid" id="services">
        <div class="section-heading"><span class="section-index mono">(04)</span><div><p class="eyebrow">What we do</p><h2>One studio.<br /><em>Three</em> directions.</h2></div></div>
        <div class="service-list">
          {services.map(([number, title, text]) => (
            <div class="service-row"><span class="mono service-number">{number}</span><h3>{title}</h3><p>{text}</p><span class="service-arrow">↗</span></div>
          ))}
        </div>
      </section>

      <section class="contact section-grid" id="contact">
        <div class="section-index mono">(05)</div>
        <div class="contact-content"><p class="eyebrow">Have a good idea?</p><h2>Let’s give it<br /><em>some pace.</em></h2><a class="contact-link" href="mailto:info@codemax.com.au">info@codemax.com.au <span>↗</span></a></div>
        <div class="contact-stamp mono">MEL<br />VIC<br />AU</div>
      </section>
    </main>

    <footer class="site-footer"><span class="brand"><span class="brand-mark">C<span>×</span></span><span>CODEMAX</span></span><span>Web design / development / growth</span><span>© 2026 CodeMax</span></footer>
  </body>
</html>
