---
import '../styles/global.css';
import '../styles/bold.css';
const services = [
 ['Web design & development','Personalised, responsive websites that turn your ideas into a clear, engaging online experience.','Websites / Redesigns / Responsive design'],
 ['Social media kit','Build your presence with social content and reels that bring your brand into the conversation.','Social content / Reels'],
 ['Graphic design','Visually compelling design that gives your business a recognisable, consistent identity.','Brand visuals / Marketing graphics'],
 ['Web marketing','SEO article writing that helps people discover your business and engage with your content.','SEO / Articles / Online visibility'],
 ['Custom support','Dedicated technical support to help keep your website and digital presence running smoothly.','Technical assistance / Website support'],
 ['Web analysis','Competitor analysis to understand your market and guide your next digital decisions.','Competitor research / Digital strategy']
];
const projects = [['Food','Food & hospitality'],['Zoo','Zoo'],['Native','Native'],['Dentist_2','Dental care'],['Heath-Future','Health Future'],['Nutrition','Nutrition'],['Dentist_1','Dental practice'],['Medical','Medical'],['Art','Art'],['Haruki','Haruki'],['Furniture','Furniture'],['Driving','Driving school'],['NFT','NFT'],['Home-Schooling','Home schooling'],['Digital-Banking-Web-Design-','Digital banking'],['Dentist-Clinic-Web-Design-','Dental clinic']];
const image = (name) => `https://codemax.com.au/wp-content/uploads/2024/01/${name}.jpg`;
---
<!doctype html>
<html lang="en-AU"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>CodeMax — Melbourne Web Design & Digital Agency</title><meta name="description" content="Melbourne web design, development, social media, graphic design, SEO content and technical support. Explore CodeMax’s portfolio and discuss your next project." /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /></head>
<body>
<header class="header wrap"><a class="brand" href="#top"><span class="mark" aria-hidden="true">C×</span> CODEMAX</a><nav aria-label="Main navigation"><a href="#services">Services</a><a href="#work">Portfolio</a><a href="#about">About</a><a href="#journal">Blog</a><a href="#contact">Contact</a></nav><a class="button small" href="mailto:info@codemax.com.au">Let’s talk ↗</a></header>
<main id="top">
 <div class="motion-bar wrap"><span class="motion-orbit" aria-hidden="true">✳</span><span>Design. Develop. Make an impression.</span><button id="motion-toggle" type="button" aria-pressed="false">Pause animation</button></div>
 <section class="hero wrap"><div class="hero-copy"><p class="eyebrow">Melbourne web design & development agency</p><h1>Make your<br />future <em>visible.</em></h1><p class="lead">Websites that look the part.<br />Digital experiences that mean business.</p><p>Starting from scratch or transforming an existing site? We bring design, development and digital marketing together to help your business connect with people and generate meaningful enquiries.</p><div class="actions"><a class="button" href="#contact">Start your project ↗</a><a class="text-link" href="#work">Explore our work ↓</a></div><div class="hero-facts"><span>Melbourne based</span><span>Personalised service</span><span>Budget-conscious solutions</span></div></div><div class="hero-showcase"><div class="showcase-label"><span>Selected design work</span><span>CODEMAX / 01</span></div><a class="hero-image" href="#work"><img src={image('Food')} alt="Food and hospitality website design from the CodeMax portfolio" width="900" height="680" fetchpriority="high" /></a><div class="showcase-bottom"><div><strong>Creativity meets connectivity.</strong><span>Web design / Brand experiences</span></div><a href="#work" aria-label="View portfolio">↗</a></div></div></section>
 <div class="service-strip"><div class="wrap">Web design <span>✳</span> Social media <span>✳</span> Graphic design <span>✳</span> Web marketing <span>✳</span> Support <span>✳</span> Analysis</div></div>
 <section class="section wrap" id="services"><div class="section-head"><div><p class="eyebrow">01 / What we do</p><h2>Everything your<br />brand needs <em>online.</em></h2></div><p>From the first impression to ongoing support, our services bring your business’s digital presence together.</p></div><div class="services-grid">{services.map(([title,description,tags],i)=><article class="service"><span class="number">0{i+1}</span><h3>{title}</h3><p>{description}</p><div class="service-bottom"><small>{tags}</small><a href={`mailto:info@codemax.com.au?subject=${encodeURIComponent(title+' enquiry')}`} aria-label={`Enquire about ${title}`}>↗</a></div></article>)}</div></section>
 <section class="work-section" id="work"><div class="wrap section"><div class="section-head"><div><p class="eyebrow">02 / Our portfolio</p><h2>Different businesses.<br /><em>Distinctive design.</em></h2></div><p>Explore the design work featured in our portfolio, across food, health, education, retail and more. Select an image to see the full design.</p></div><div class="portfolio">{projects.slice(0,6).map(([file,title],i)=><a class="project" href={image(file)} target="_blank" rel="noopener noreferrer"><div class="project-image"><img src={image(file)} alt={`${title} website design`} width="700" height="520" loading="lazy" /></div><div class="project-caption"><span><small>Web design / {String(i+1).padStart(2,'0')}</small><strong>{title}</strong></span><span aria-hidden="true">↗</span></div></a>)}</div><details class="more-work"><summary>Explore all 16 portfolio designs <span>+</span></summary><div class="portfolio">{projects.slice(6).map(([file,title],i)=><a class="project" href={image(file)} target="_blank" rel="noopener noreferrer"><div class="project-image"><img src={image(file)} alt={`${title} website design`} width="700" height="520" loading="lazy" /></div><div class="project-caption"><span><small>Web design / {String(i+7).padStart(2,'0')}</small><strong>{title}</strong></span><span aria-hidden="true">↗</span></div></a>)}</div></details></div></section>
 <section class="enquiry-section" id="enquiry" aria-labelledby="enquiry-title"><div class="wrap enquiry-grid"><div><p class="eyebrow">Your next move starts here</p><h2 id="enquiry-title">Big idea?<br />Let’s <em>hear it.</em></h2><p>Tell us what you have in mind. A new website, a fresh identity or a stronger digital presence — let’s make it happen.</p><a href="tel:+61494597993">Prefer a chat? 0494 597 993 ↗</a></div>
 <form id="enquiry-form" action="mailto:info@codemax.com.au" method="post" enctype="text/plain" aria-describedby="form-note"><div class="form-fields"><label>Your name<input name="name" autocomplete="name" required maxlength="100" /></label><label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254" /></label><label>Business name <span>(optional)</span><input name="company" autocomplete="organization" maxlength="120" /></label><label>What do you need?<select name="service" required><option value="">Select a service</option>{services.map(([title])=><option>{title}</option>)}<option>Something else</option></select></label><label class="form-wide">Tell us about your project<textarea name="message" required minlength="10" maxlength="2000" rows="4" placeholder="Your goals, your ideas, your timeline…"></textarea></label></div><p id="form-note">Opens a draft in your email app. Review it and press Send to contact CodeMax.</p><button class="button" type="submit">Prepare my enquiry ↗</button><p id="form-status" role="status" aria-live="polite"></p><noscript><p>You can also email your brief directly to info@codemax.com.au.</p></noscript></form></div></section>
 <section class="section wrap about" id="about"><div><p class="eyebrow">03 / About CodeMax</p><h2>A small team.<br />A personal approach.<br /><em>Your next chapter.</em></h2><div class="founder"><span class="initials">SD</span><div><strong>Subodha D</strong><span>Founder, CodeMax</span></div></div></div><div class="about-copy"><p class="lead">Thoughtful design. Clear communication. A team invested in your business.</p><p>We’re a Melbourne-based web development team committed to bringing your online vision to life within your budget. We combine cost-effective solutions with personalised service, tailoring each project to your needs.</p><p>Our mission is to create digital experiences that elevate brands and help them connect with people. From design through delivery, we focus on user-friendly interfaces and open collaboration.</p><div class="values"><div><h3>Built around you</h3><p>Personalised solutions that reflect your business and its goals.</p></div><div><h3>Open collaboration</h3><p>Transparent communication throughout the design process.</p></div><div><h3>Punctuality matters</h3><p>A commitment to delivering your website on time.</p></div><div><h3>Design with purpose</h3><p>Creative, usable experiences that support your online presence.</p></div></div></div></section>
 <section class="feature-band"><div class="wrap feature-inner"><div><p class="eyebrow">It’s never too late</p><h2>Step into<br />the <em>limelight.</em></h2></div><div><p>Showcase your talents, skills and achievements with an online presence that reflects who you are. Whether you’re launching a business or refreshing your brand, your next step can start today.</p><a class="button" href="mailto:info@codemax.com.au">Let’s discuss your idea ↗</a></div></div></section>
 <section class="section wrap" id="journal"><div class="section-head"><div><p class="eyebrow">04 / From the blog</p><h2>Ideas for your<br /><em>digital presence.</em></h2></div><a class="text-link" href="https://codemax.com.au/blog/">Explore the CodeMax blog ↗</a></div><div class="journal-grid"><a href="https://codemax.com.au/blog/" class="journal"><small>SEO / Mobile</small><h3>Mobile SEO for Australian websites</h3><p>Explore the role of mobile optimisation in search visibility and user experience.</p><span>Read on the blog ↗</span></a><a href="https://codemax.com.au/blog/" class="journal"><small>SEO / Local business</small><h3>Getting found in your local market</h3><p>Local search ideas for businesses looking to connect with nearby customers.</p><span>Read on the blog ↗</span></a><a href="https://codemax.com.au/blog/" class="journal"><small>SEO / Regional Australia</small><h3>Online visibility beyond the city</h3><p>Search strategies and opportunities for regional Australian businesses.</p><span>Read on the blog ↗</span></a></div></section>
 <section class="contact" id="contact"><div class="wrap contact-grid"><div><p class="eyebrow">05 / Let’s discuss</p><h2>Your future.<br /><em>Let’s build it.</em></h2><p>Tell us about your business, your ideas and what you need from your website.</p><a class="button" href="mailto:info@codemax.com.au">Email your project brief ↗</a></div><div class="contact-details"><div><small>Email us</small><a href="mailto:info@codemax.com.au">info@codemax.com.au ↗</a></div><div><small>Call us</small><a href="tel:+61494597993">0494 597 993 ↗</a></div><div><small>Our address</small><address>1341 Dandenong Rd<br />Malvern East VIC 3145</address></div></div></div></section>
</main><footer class="wrap footer"><a class="brand" href="#top">CODEMAX</a><p>Web design & digital experiences / Melbourne</p><a href="https://codemax.com.au/blog/">Blog ↗</a><span>© {new Date().getFullYear()} CodeMax</span></footer>
<script>
 const form = document.querySelector<HTMLFormElement>('#enquiry-form');
 form?.addEventListener('submit', event => {
  event.preventDefault();
  if (!form.reportValidity()) return;
  const data = new FormData(form);
  const body = ['Name: '+data.get('name'), 'Email: '+data.get('email'), 'Business: '+(data.get('company') || 'Not provided'), 'Service: '+data.get('service'), '', data.get('message')].join('\n');
  window.location.href = 'mailto:info@codemax.com.au?subject='+encodeURIComponent('CodeMax enquiry — '+data.get('service'))+'&body='+encodeURIComponent(body);
  const status = document.querySelector('#form-status');
  if (status) status.textContent = 'Your email app should open with your enquiry. If it does not, email info@codemax.com.au directly. Your message has not been sent by this website.';
 });
 document.querySelectorAll<HTMLAnchorElement>('.header .button, .hero .actions .button, .header nav a[href="#contact"]').forEach(link => link.href = '#enquiry');
 const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
 const toggle = document.querySelector<HTMLButtonElement>('#motion-toggle');
 let paused = motion.matches;
 function updateMotion() {
  document.documentElement.classList.toggle('motion-paused', paused);
  if (toggle) { toggle.setAttribute('aria-pressed', String(paused)); toggle.textContent = motion.matches ? 'Reduced motion enabled' : paused ? 'Play animation' : 'Pause animation'; toggle.disabled = motion.matches; }
 }
 toggle?.addEventListener('click', () => { paused = !paused; updateMotion(); });
 motion.addEventListener('change', () => { paused = motion.matches; updateMotion(); });
 updateMotion();
 if (!motion.matches && 'IntersectionObserver' in window) {
  const observer = new IntersectionObserver((entries) => {
   for (const entry of entries) {
    if (!entry.isIntersecting) continue;
    const element = entry.target as HTMLElement;
    if (!paused) element.animate([{ opacity: .3, transform: 'translateY(22px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 650, easing: 'cubic-bezier(.2,.7,.2,1)' });
    observer.unobserve(element);
   }
  }, { threshold: .12 });
  document.querySelectorAll('.section-head, .service, .project, .about-copy, .journal, .contact-details').forEach(el => observer.observe(el));
  motion.addEventListener('change', () => {
   if (motion.matches) { observer.disconnect(); document.getAnimations().forEach(animation => animation.cancel()); }
  });
 }
</script>
</body></html>
