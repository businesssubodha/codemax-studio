<script>
 const form = document.querySelector<HTMLFormElement>('#enquiry-form');
 // Start verification near the form, instead of competing with the initial page render.
 if (form?.dataset.endpoint) {
  let securityRequested = false;
  const loadSecurity = () => {
   if (securityRequested) return;
   securityRequested = true;
   const script = document.createElement('script');
   script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
   script.async = true;
   script.onerror = () => {
    securityRequested = false;
    script.remove();
    const status = document.querySelector<HTMLElement>('#form-status');
    if (status) status.textContent = 'The security check could not load. Focus a form field to retry, or email info@codemax.com.au.';
   };
   document.head.append(script);
  };
  form.addEventListener('focusin', loadSecurity);
  form.addEventListener('pointerdown', loadSecurity);
  if ('IntersectionObserver' in window) {
   const securityObserver = new IntersectionObserver(entries => {
    if (entries.some(entry => entry.isIntersecting)) { loadSecurity(); securityObserver.disconnect(); }
   }, { rootMargin: '500px' });
   securityObserver.observe(form);
  } else loadSecurity();
 }
 const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
 if (submitButton) submitButton.disabled = false;
 form?.addEventListener('submit', async event => {
  event.preventDefault();
  if (!form.reportValidity()) return;
  const data = new FormData(form);
  if (form.dataset.endpoint) {
   const status = document.querySelector<HTMLElement>('#form-status')!;
   const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
   if (button.disabled) return;
   const token = String(data.get('cf-turnstile-response') || '');
   if (!token) { status.textContent = 'Please complete the security check. If it does not load, email info@codemax.com.au.'; return; }
   const buttonLabel = button.querySelector<HTMLElement>('[data-submit-label]')!;
   button.disabled = true; buttonLabel.textContent = 'Sending…'; form.setAttribute('aria-busy', 'true');
   status.textContent = 'Submitting your enquiry…';
   try {
    const response = await fetch(form.dataset.endpoint, {
     method: 'POST', headers: { 'Content-Type': 'application/json' }, signal: AbortSignal.timeout(30000),
     body: JSON.stringify({ name: data.get('name'), email: data.get('email'), company: data.get('company') || '', service: data.get('service'), message: data.get('message'), website: data.get('website') || '', token })
    });
    const result = await response.json();
    if (!response.ok || result.ok !== true) throw new Error(result.message || 'Unable to submit. Please try again.');
    status.textContent = result.message; form.reset();
   } catch (error) {
    status.textContent = error instanceof Error && error.message && !['TypeError', 'TimeoutError', 'AbortError'].includes(error.name) ? error.message : 'We could not confirm submission. Please try again or email info@codemax.com.au.';
   } finally {
    const turnstile = (window as Window & { turnstile?: { reset: () => void } }).turnstile;
    turnstile?.reset(); button.disabled = false; buttonLabel.textContent = 'Send my enquiry'; form.removeAttribute('aria-busy');
   }
   return;
  }
  const body = ['Name: '+data.get('name'), 'Email: '+data.get('email'), 'Business: '+(data.get('company') || 'Not provided'), 'Service: '+data.get('service'), '', data.get('message')].join('\n');
  window.location.href = 'mailto:info@codemax.com.au?subject='+encodeURIComponent('CodeMax enquiry — '+data.get('service'))+'&body='+encodeURIComponent(body);
  const status = document.querySelector('#form-status');
  if (status) status.textContent = 'Your email app should open with your enquiry. If it does not, email info@codemax.com.au directly. Your message has not been sent by this website.';
 });
 document.querySelectorAll<HTMLAnchorElement>('.header .button, .hero .actions .button, .header nav a[href="#contact"]').forEach(link => link.href = '#enquiry');
 const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
 let paused = motion.matches;
 motion.addEventListener('change', () => { paused = motion.matches; });
 if (!motion.matches && 'IntersectionObserver' in window) {
  const observer = new IntersectionObserver((entries) => {
   for (const entry of entries) {
    if (!entry.isIntersecting) continue;
    const element = entry.target as HTMLElement;
    if (!paused) element.animate([{ opacity: .3, transform: 'translateY(22px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 650, easing: 'cubic-bezier(.2,.7,.2,1)' });
    observer.unobserve(element);
   }
  }, { threshold: .12 });
  document.querySelectorAll('.section-head, .service, .project, .about-copy, .journal, .contact-details').forEach(el => observer.observe(el));
  motion.addEventListener('change', () => {
   if (motion.matches) { observer.disconnect(); document.getAnimations().forEach(animation => animation.cancel()); }
  });
 }
</script>
</body></html>
