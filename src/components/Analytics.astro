---
import config from '../data/analytics.json';
const id = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || config.measurementId;
const enabled = /^G-[A-Z0-9]+$/.test(id);
---
{enabled && <aside id="analytics-choice" data-measurement-id={id} aria-label="Optional analytics" hidden><p>Allow optional analytics to help us understand page visits and contact actions? Enquiry text and contact details are not included in these events.</p><div><button type="button" data-analytics="allow">Allow analytics</button><button type="button" data-analytics="decline">No thanks</button></div></aside>}
{enabled && <button id="analytics-settings" type="button">Analytics preferences</button>}
<script>
 import { setupAnalytics } from '../lib/analytics';
 setupAnalytics();
</script>
<style>
#analytics-choice{position:fixed;z-index:100;bottom:58px;left:4%;width:min(520px,92%);padding:22px;background:#f7f6f2;color:#151513;border:2px solid #151513;box-shadow:5px 5px 0 #ff4b19;font-size:14px}
#analytics-choice[hidden]{display:none}#analytics-choice div{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px}
button{font:inherit;cursor:pointer;border:1px solid #151513;padding:10px 15px;background:#f7f6f2;color:#151513;min-height:44px}
button[data-analytics="allow"]{background:#ff4b19}#analytics-settings{position:fixed;bottom:8px;left:12px;z-index:90;font-size:12px;border-radius:4px}
</style>
